{
  "manifest_version": 3,
  "name": "LeetX Squads: Sync & Multiplayer DSA",
  "version": "2.1.2",
  "description": "Keep a daily LeetCode streak with friends: squads, 1v1 duels, reminders, roadmaps and automatic GitHub backup.",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "leetx-squads@ninja981.github.io",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "websiteActivity"]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "identity"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "scripts": ["scripts/background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "LeetX Squads",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/content.css"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
